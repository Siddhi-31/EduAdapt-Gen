# Environment Configuration
APP_ENV=development
APP_NAME="EduAdapt Generative AI Module"
LOG_LEVEL=INFO

# LLM Inference Provider Configuration
# Supported providers: mock, ollama (unsupported providers will be rejected)
LLM_PROVIDER=mock
LLM_MODEL_NAME=mistral:7b
LLM_API_KEY=
LLM_API_BASE=http://localhost:11434
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=180.0

# Downstream / External Integration Mock Endpoints (Owned by other teams)
RAG_SERVICE_URL=http://localhost:8001
STUDENT_MODEL_SERVICE_URL=http://localhost:8002
ACCESSIBILITY_SERVICE_URL=http://localhost:8003

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://username:password@localhost:5432/eduadapt
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/eduadapt
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Authentication & Security Configuration
# Generate a cryptographically secure key: openssl rand -hex 32
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30

# SMTP / Email Delivery Configuration (Leave empty to use dev_code mode in non-production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@eduadapt.app
SMTP_USE_TLS=true
